# Nexus AI Gateway Configuration
NEXUS_PORT=3060
NEXUS_HOST=0.0.0.0

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_DEFAULT_MODEL=google/gemma-3-27b-it:free
OPENROUTER_APP_TITLE=Nexus AI Gateway

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1

# Routing
AI_PROVIDER_PRIORITY=openrouter,ollama
MODEL_CATALOG_POLL_INTERVAL_MS=300000
